// Counting with a string-keyed map.
fn tally(n: Int) -> Int {
    let names = range(5000).map(|i| "key{i}")
    var counts: Map[Str, Int] = [:]
    for i in 0..n {
        let name = names[i * 7919 % 5000]
        counts[name] = counts.get_or(name, 0) + 1
    }
    var checksum = 0
    for (name, hits) in items(counts) {
        checksum += hits * len(name)
    }
    checksum + len(counts)
}

print(tally(2000000))
