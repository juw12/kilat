// n-body simulation (5 bodies): float arithmetic and list indexing.
let solar_mass = 39.47841760435743
let days_per_year = 365.24

fn energy(x: List[Float], y: List[Float], z: List[Float],
          vx: List[Float], vy: List[Float], vz: List[Float], mass: List[Float]) -> Float {
    var e = 0.0
    let n = len(x)
    for i in 0..n {
        e += 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
        for j in (i + 1)..n {
            let dx = x[i] - x[j]
            let dy = y[i] - y[j]
            let dz = z[i] - z[j]
            e -= mass[i] * mass[j] / sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    e
}

fn advance(x: List[Float], y: List[Float], z: List[Float],
           vx: List[Float], vy: List[Float], vz: List[Float], mass: List[Float],
           dt: Float, steps: Int) {
    let n = len(x)
    for step in 0..steps {
        for i in 0..n {
            for j in (i + 1)..n {
                let dx = x[i] - x[j]
                let dy = y[i] - y[j]
                let dz = z[i] - z[j]
                let d2 = dx * dx + dy * dy + dz * dz
                let mag = dt / (d2 * sqrt(d2))
                let mi = mass[i] * mag
                let mj = mass[j] * mag
                vx[i] -= dx * mj
                vy[i] -= dy * mj
                vz[i] -= dz * mj
                vx[j] += dx * mi
                vy[j] += dy * mi
                vz[j] += dz * mi
            }
        }
        for i in 0..n {
            x[i] += dt * vx[i]
            y[i] += dt * vy[i]
            z[i] += dt * vz[i]
        }
    }
}

var x = [0.0, 4.84143144246472090, 8.34336671824457987, 12.8943695621391310, 15.3796971148509165]
var y = [0.0, -1.16032004402742839, 4.12479856412430479, -15.1111514016986312, -25.9193146099879641]
var z = [0.0, -0.103622044471123109, -0.403523417114321381, -0.223307578892655734, 0.179258772950371181]
var vx = [0.0, 0.00166007664274403694, -0.00276742510726862411, 0.00296460137564761618, 0.00268067772490389322]
var vy = [0.0, 0.00769901118419740425, 0.00499852801234917238, 0.00237847173959480950, 0.00162824170038242295]
var vz = [0.0, -0.0000690460016972063023, 0.0000230417297573763929, -0.0000296589568540237556, -0.0000951592254519715870]
var mass = [1.0, 0.000954791938424326609, 0.000285885980666130812, 0.0000436624404335156298, 0.0000515138902046611451]

var px = 0.0
var py = 0.0
var pz = 0.0
for i in 0..5 {
    vx[i] = vx[i] * days_per_year
    vy[i] = vy[i] * days_per_year
    vz[i] = vz[i] * days_per_year
    mass[i] = mass[i] * solar_mass
    px += vx[i] * mass[i]
    py += vy[i] * mass[i]
    pz += vz[i] * mass[i]
}
vx[0] = -px / solar_mass
vy[0] = -py / solar_mass
vz[0] = -pz / solar_mass

let before = energy(x, y, z, vx, vy, vz, mass)
print("{before:.9}")
advance(x, y, z, vx, vy, vz, mass, 0.01, 100000)
let after = energy(x, y, z, vx, vy, vz, mass)
print("{after:.9}")
