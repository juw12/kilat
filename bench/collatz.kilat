// Longest Collatz chain below a limit: integer division and branches.
fn longest(limit: Int) -> (Int, Int) {
    var best = 0
    var best_start = 0
    for start in 1..limit {
        var x = start
        var steps = 0
        while x != 1 {
            if x % 2 == 0 {
                x = x div 2
            } else {
                x = 3 * x + 1
            }
            steps += 1
        }
        if steps > best {
            best = steps
            best_start = start
        }
    }
    (best_start, best)
}

let (start, steps) = longest(100000)
print("{start} {steps}")
