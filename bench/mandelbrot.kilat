// Mandelbrot set membership count: float arithmetic in tight loops.
fn mandel(size: Int, max_iter: Int) -> Int {
    var inside = 0
    for row in 0..size {
        let ci = 2.0 * row / size - 1.0
        for col in 0..size {
            let cr = 3.0 * col / size - 2.0
            var zr = 0.0
            var zi = 0.0
            var i = 0
            while i < max_iter and zr * zr + zi * zi <= 4.0 {
                let next = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = next
                i += 1
            }
            if i == max_iter {
                inside += 1
            }
        }
    }
    inside
}

print(mandel(300, 200))
