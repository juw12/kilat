// Maps under churn: these paths exercise the open-addressing table, the cached
// string hashes, and the collector running while a map is in use.

// many integer keys, removal of half, then adding them back
var squares: Map[Int, Int] = [:]
for i in 0..5000 { squares[i] = i * i }
assert_eq(len(squares), 5000)
for i in 0..5000 {
    if i % 2 == 0 { assert_eq(remove(squares, i), Some(i * i)) }
}
assert_eq(len(squares), 2500)
assert_eq(get(squares, 10), None)
assert_eq(squares[11], 121)
for i in 0..5000 {
    if i % 2 == 0 { squares[i] = -i }
}
assert_eq(len(squares), 5000)
assert_eq(squares[10], -10)
assert_eq(squares[4999], 4999 * 4999)
// survivors keep their place; re-added keys go to the end
assert_eq(slice(keys(squares), 0, 3), [1, 3, 5])
assert_eq(last(keys(squares)), Some(4998))
print("int churn ok")

// one slot reused many times must not grow or lose entries
var slot: Map[Int, Int] = [:]
for round in 0..20000 {
    slot[round] = round
    if round > 0 { assert_eq(remove(slot, round - 1), Some(round - 1)) }
}
assert_eq(len(slot), 1)
assert_eq(keys(slot), [19999])
print("slot reuse ok")

// negative, zero and large integer keys
var wide: Map[Int, Str] = [:]
wide[0] = "zero"
wide[-1] = "minus one"
wide[9223372036854775807] = "max"
wide[-9223372036854775807] = "near min"
assert_eq(wide[0], "zero")
assert_eq(wide[-1], "minus one")
assert_eq(wide[9223372036854775807], "max")
assert_eq(get(wide, 1), None)
print("wide keys ok")

// equal text held in different string objects is the same key
var stock: Map[Str, Int] = [:]
stock["abc"] = 1
let built = "ab" + "c"
assert_eq(stock[built], 1)
stock[built] = 2
assert_eq(len(stock), 1)
assert_eq(stock["abc"], 2)
assert_eq(has(stock, join(["a", "b", "c"], "")), true)
assert_eq(has(stock, "abd"), false)
assert_eq(has(stock, ""), false)
stock[""] = 7
assert_eq(stock[""], 7)
print("string keys ok")

// string keys under churn, with enough garbage to make the collector run
var words: Map[Str, Int] = [:]
for i in 0..3000 { words["w" + str(i)] = i }
var junk = 0
for round in 0..60 {
    for i in 0..3000 {
        let key = "w" + str(i)
        junk += len(key + "-" + str(round))
        if (i + round) % 7 == 0 {
            assert_eq(remove(words, key), Some(i))
            words["w" + str(i)] = i
        }
    }
}
assert(junk > 0)
assert_eq(len(words), 3000)
var total = 0
for i in 0..3000 { total += words["w" + str(i)] }
assert_eq(total, 2999 * 3000 div 2)
assert_eq(get(words, "w3000"), None)
print("string churn ok")

// equality compares content, not insertion order; copies are independent
let left = ["a": 1, "b": 2]
let right = ["a": 1, "b": 2]
assert_eq(left == right, true)
assert_eq(left == ["a": 1, "b": 3], false)
assert_eq(left == ["a": 1], false)
assert_eq(left == ["b": 2, "a": 1], true)
let twin = copy(left)
twin["c"] = 3
assert_eq(len(left), 2)
assert_eq(len(twin), 3)
assert_eq(remove(twin, "a"), Some(1))
assert_eq(left["a"], 1)
print("equality and copy ok")

// a repeated key in JSON text keeps its first place and its last value
let repeated = json_parse("{{\"k\": 1, \"k\": 2, \"j\": 3}}").unwrap()
assert_eq(json_str(repeated), "{{\"k\":2,\"j\":3}}")
print("json repeated key ok")

// clear, then reuse
words.clear()
assert_eq(len(words), 0)
assert_eq(get(words, "w1"), None)
words["again"] = 1
assert_eq(keys(words), ["again"])
print("clear ok")

// power-of-two divisors take a shortcut; it must match the general rule
fn check_divisor(k: Int) {
    for x in -40..41 {
        let quotient = x div k
        let rest = x % k
        assert_eq(quotient * k + rest, x)
        assert(rest >= 0 and rest < k)
    }
}
check_divisor(1); check_divisor(2); check_divisor(8); check_divisor(64); check_divisor(7)
assert_eq(-1 % 8, 7); assert_eq(-8 % 8, 0); assert_eq(-9 % 8, 7); assert_eq(9 % 8, 1)
assert_eq(-1 div 8, -1); assert_eq(-8 div 8, -1); assert_eq(-9 div 8, -2); assert_eq(9 div 8, 1)
assert_eq(-5 % 1, 0); assert_eq(-5 div 1, -5); assert_eq(5 % 1, 0); assert_eq(5 div 1, 5)
assert_eq(-5 % 2, 1); assert_eq(-5 div 2, -3)
let low = -9223372036854775807 - 1
assert_eq(low % 8, 0); assert_eq(low div 8, -1152921504606846976)
assert_eq(low % 1024, 0); assert_eq((low + 1) % 1024, 1)
assert_eq(9223372036854775807 % 4096, 4095); assert_eq(9223372036854775807 div 4096, 2251799813685247)
print("power-of-two division ok")
