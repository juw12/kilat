
// strings
assert_eq(len("héllo"), 5)
assert_eq(upper("abc"), "ABC")
assert_eq(lower("ÀBC"), "àbc")
assert_eq(trim("  x \n"), "x")
assert_eq("a,b,,c".split(","), ["a", "b", "", "c"])
assert_eq(lines("a\nb\r\nc"), ["a", "b", "c"])
assert_eq(chars("hé"), ["h", "é"])
assert_eq(join(["a", "b"], "-"), "a-b")
assert_eq(contains("hello", "ell"), true)
assert_eq(starts_with("hello", "he"), true)
assert_eq(ends_with("hello", "lo"), true)
assert_eq(replace("aaa", "a", "bb"), "bbbbbb")
assert_eq(find("hello", "l"), Some(2))
assert_eq(find("hello", "z"), None)
assert_eq(find("héllo", "l"), Some(2))
assert_eq(slice("héllo", 1, 3), "él")
assert_eq(repeat("ab", 3), "ababab")
assert_eq(to_int("42"), Some(42))
assert_eq(to_int("-7"), Some(-7))
assert_eq(to_int("x"), None)
assert_eq(to_float("2.5"), Some(2.5))
assert_eq(to_float("abc"), None)
assert_eq(pad_left("7", 3), "  7")
assert_eq(pad_right("7", 3) + "|", "7  |")
assert_eq(char_code("A"), 65)
assert_eq(from_char_code(233), "é")
assert_eq(is_empty(""), true)
assert_eq("héllo"[1], "é")
assert_eq("abc"[-1], "c")
assert_eq("a" + "b", "ab")
assert_eq("a" < "b", true)
assert_eq(str(12) + str(1.5) + str(true), "121.5true")
assert_eq('single {not} interpolated', "single {{not}} interpolated")
assert_eq("tab\there \u{41}", "tab	here A")
print("strings ok")

// lists
var xs = [3, 1, 2]
xs.push(5)
assert_eq(xs, [3, 1, 2, 5])
assert_eq(xs.pop(), Some(5))
assert_eq(first(xs), Some(3))
assert_eq(last(xs), Some(2))
assert_eq(contains(xs, 2), true)
assert_eq(index_of(xs, 2), Some(2))
assert_eq(index_of(xs, 9), None)
xs.insert(1, 9)
assert_eq(xs, [3, 9, 1, 2])
assert_eq(xs.remove_at(0), 3)
assert_eq(slice(xs, 0, 2), [9, 1])
assert_eq(reverse(xs), [2, 1, 9])
assert_eq(sort(xs), [1, 2, 9])
assert_eq(xs, [9, 1, 2])
assert_eq(concat(xs, [7]), [9, 1, 2, 7])
assert_eq(range(3), [0, 1, 2])
assert_eq(range(2, 5), [2, 3, 4])
assert_eq(range(10, 0, -3), [10, 7, 4, 1])
assert_eq(fill(3, 0), [0, 0, 0])
let ys = copy(xs)
ys.push(1)
assert_eq(len(xs), 3)
xs.extend([4, 5])
assert_eq(xs, [9, 1, 2, 4, 5])
assert_eq(xs[-1], 5)
xs[0] = 7
assert_eq(xs[0], 7)
xs.clear()
assert_eq(is_empty(xs), true)
assert_eq(min([3, 1, 2]), 1)
assert_eq(max([3.5, 1.0]), 3.5)
assert_eq(min(2, 3), 2)
assert_eq(max("a", "b"), "b")
assert_eq(sum([1, 2, 3]), 6)
assert_eq(sum([1.5, 2.5]), 4.0)
assert_eq(sort(["b", "a", "C"]), ["C", "a", "b"])
assert_eq(sort([2.5, -1.0, 0.0]), [-1.0, 0.0, 2.5])
print("lists ok")

// prelude list functions
assert_eq(map([1, 2, 3], |x| x * 2), [2, 4, 6])
assert_eq(filter([1, 2, 3, 4], |x| x % 2 == 0), [2, 4])
assert_eq(reduce([1, 2, 3], 10, |a, b| a + b), 16)
let acc: List[Int] = []
each([1, 2], |x| acc.push(x))
assert_eq(acc, [1, 2])
assert_eq(count([1, 2, 3], |x| x > 1), 2)
assert_eq(find([1, 2, 3], |x| x > 1), Some(2))
assert_eq(flat_map([1, 2], |x| [x, x]), [1, 1, 2, 2])
assert_eq(zip([1, 2], ["a", "b"]), [(1, "a"), (2, "b")])
assert_eq(enumerate(["x"]), [(0, "x")])
assert_eq(sort_by(["ccc", "a", "bb"], |s| len(s)), ["a", "bb", "ccc"])
assert_eq([1, 2, 3].map(|x| x + 1).filter(|x| x > 2).sum(), 7)
print("prelude ok")

// maps
var m = ["a": 1, "b": 2]
m["c"] = 3
assert_eq(len(m), 3)
assert_eq(m["a"], 1)
assert_eq(get(m, "z"), None)
assert_eq(m.get("b"), Some(2))
assert_eq(get_or(m, "z", 0), 0)
assert_eq(has(m, "a"), true)
assert_eq(remove(m, "a"), Some(1))
assert_eq(remove(m, "a"), None)
assert_eq(keys(m), ["b", "c"])
assert_eq(values(m), [2, 3])
assert_eq(items(m), [("b", 2), ("c", 3)])
m["b"] += 10
assert_eq(m["b"], 12)
let m2 = copy(m)
m2["zz"] = 1
assert_eq(len(m), 2)
var im: Map[Int, Str] = [:]
im[5] = "five"
im[-1] = "neg"
assert_eq(im.keys(), [5, -1])
for (k, v) in items(m) {
    print(k, v)
}
m.clear()
assert_eq(is_empty(m), true)
print(["x": [1, 2]], [1: "a"])
print("maps ok")

// math
assert_eq(abs(-3), 3)
assert_eq(abs(-2.5), 2.5)
assert_eq(clamp(15, 0, 10), 10)
assert_eq(floor(2.7), 2); assert_eq(floor(-2.1), -3)
assert_eq(ceil(2.1), 3)
assert_eq(round(2.5), 3); assert_eq(round(-2.5), -3)
assert_eq(trunc(-2.7), -2)
assert_eq(round_to(2.675, 2), 2.68)
assert_eq(int(3.9), 3)
assert_eq(float(3), 3.0)
assert(approx(sin(pi / 2), 1.0, 1e-12))
assert(approx(cos(0.0), 1.0, 1e-12))
assert(approx(atan2(1.0, 1.0), pi / 4, 1e-12))
assert(approx(exp(1.0), 2.718281828459045, 1e-12))
assert(approx(ln(exp(2.0)), 2.0, 1e-12))
assert(approx(log10(1000.0), 3.0, 1e-12))
assert(approx(log2(8.0), 3.0, 1e-12))
assert_eq(sqrt(16.0), 4.0)
assert_eq(2 ^ 10, 1024)
assert_eq(7 div 2, 3); assert_eq(-7 div 2, -4); assert_eq(-7 % 3, 2); assert_eq(7 % -3, -2)
assert_eq(7 / 2, 3.5)
assert_eq(0x10 + 0b11 + 1_000, 1019)
assert_eq(is_nan(0.0), false)
rand_seed(42)
let r1 = rand()
rand_seed(42)
assert_eq(rand(), r1)
assert(r1 >= 0.0 and r1 < 1.0)
let ri = rand_int(1, 6)
assert(ri >= 1 and ri <= 6)
print("math ok")

// statistics
assert_eq(mean([1, 2, 3, 4]), 2.5)
assert_eq(mean([1.5, 2.5]), 2.0)
assert_eq([1, 2, 3, 4].mean(), 2.5)
assert_eq(median([3, 1, 2]), 2.0)
assert_eq(median([4, 1, 3, 2]), 2.5)
assert_eq(median([7.5]), 7.5)
assert(approx(stddev([2, 4, 4, 4, 5, 5, 7, 9]), 2.138089935299395, 1e-12))
assert_eq(stddev([3.0, 3.0, 3.0]), 0.0)
assert(approx(mean([1e16, 1.0, -1e16]), 1.0 / 3.0, 1e-15))
let spans = [10 mm, 20 mm, 60 mm]
assert(approx(mean(spans) in mm, 30.0, 1e-9))
assert(approx(median(spans) in mm, 20.0, 1e-9))
assert(approx(stddev(spans) in mm, 26.457513110645905, 1e-9))
let mean_span: m = spans.mean()
assert(mean_span > 29 mm and mean_span < 31 mm)
let before_stats = [3, 1, 2]
assert_eq(median(before_stats), 2.0)
assert_eq(before_stats, [3, 1, 2])
print("statistics ok")

// split: the one-byte fast path and the general path give the same parts
assert_eq(split("", ","), [""])
assert_eq(split(",", ","), ["", ""])
assert_eq(split(",a,", ","), ["", "a", ""])
assert_eq(split("a,b,,c", ","), ["a", "b", "", "c"])
assert_eq(split("a--b--c", "--"), ["a", "b", "c"])
assert_eq(split("naïve,café,日本", ","), ["naïve", "café", "日本"])
assert_eq(split("日本、東京、大阪", "、"), ["日本", "東京", "大阪"])
assert_eq(split("aéb", "é"), ["a", "b"])
