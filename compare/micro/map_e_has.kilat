fn tally(n: Int) -> Int {
    let names = range(5000).map(|i| "key{i}")
    var counts: Map[Str, Int] = [:]
    for name in names {
        counts[name] = 1
    }
    var checksum = 0
    for i in 0..n {
        let name = names[i * 7919 % 5000]
        if has(counts, name) {
            checksum += 1
        }
    }
    checksum + len(counts)
}
print(tally(2000000))
